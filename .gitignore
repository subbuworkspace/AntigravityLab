highscore.json

# Local Generated media outputs (keep repo lightweight)
**/outputs/*.png
**/outputs/*.json
!**/outputs/.gitkeep

# OS generated files
Thumbs.db
desktop.ini
.DS_Store

# Editor files
.vscode/
.idea/
*.swp
