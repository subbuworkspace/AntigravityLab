# Environment variables & secrets (CRITICAL: NEVER COMMIT KEYS)
.env
*.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd

# Virtual Environments
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

